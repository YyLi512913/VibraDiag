# Copy to .env and fill locally. Never commit the actual .env.
DEEPSEEK_API_KEY=
VIBRADIAG_ALLOW_EXTERNAL_LLM=false
VIBRADIAG_LLM_PROVIDER=deepseek
VIBRADIAG_DEEPSEEK_MODEL=deepseek-flash
# Separate non-superuser application and migration accounts. Fill privately.
VIBRADIAG_DATABASE_URL=
VIBRADIAG_MIGRATION_DATABASE_URL=
VIBRADIAG_TEST_DATABASE_URL=
VIBRADIAG_TEST_MIGRATION_DATABASE_URL=
VIBRADIAG_COOKIE_SECURE=true
# Only enable on loopback for the existing unauthenticated experimental UI.
VIBRADIAG_ENABLE_PROTOTYPE=false
# Private originals for the formal measurement API; never frontend/public.
VIBRADIAG_DATA_ROOT=
# One hosted rule-task consumer under the single API lease; not a model Agent.
VIBRADIAG_AGENT_WORKER_ENABLED=true
