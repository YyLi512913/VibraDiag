# Copy to .env and fill locally. Never commit the actual .env.
DEEPSEEK_API_KEY=
VIBRADIAG_ALLOW_EXTERNAL_LLM=false
VIBRADIAG_LLM_PROVIDER=deepseek
VIBRADIAG_DEEPSEEK_MODEL=deepseek-flash
# Explicit deepseek or ollama. New model tasks pin the chosen configuration; no fallback.
VIBRADIAG_FORMAL_LLM_PROVIDER=deepseek
# Opt-in model method graph; rules is the safe default. Numerical tasks keep their existing graph.
VIBRADIAG_METHOD_EXECUTOR=rules
# Separate non-superuser application and migration accounts. Fill privately.
VIBRADIAG_DATABASE_URL=
VIBRADIAG_MIGRATION_DATABASE_URL=
VIBRADIAG_TEST_DATABASE_URL=
VIBRADIAG_TEST_MIGRATION_DATABASE_URL=
VIBRADIAG_COOKIE_SECURE=true
# Only enable on loopback for the existing unauthenticated experimental UI.
VIBRADIAG_ENABLE_PROTOTYPE=false
# Private originals for the formal measurement API; never frontend/public.
VIBRADIAG_DATA_ROOT=
# One hosted rule-task consumer under the single API lease; not a model Agent.
VIBRADIAG_AGENT_WORKER_ENABLED=true
# Pure numerical children use one API-owned capacity gate. No production inline fallback.
VIBRADIAG_NUMERIC_BACKEND=process
# Child wall-clock deadline, including startup/IPC; 100..120000 ms, task remainder may lower it.
VIBRADIAG_NUMERIC_TIMEOUT_MS=120000

# Opt-in model planner for new numerical tasks; method mode is independent.
VIBRADIAG_NUMERIC_EXECUTOR=rules

# model_v2 opts new numerical tasks into scoped requirement context; model retains v1.
# VIBRADIAG_NUMERIC_EXECUTOR=model_v2
