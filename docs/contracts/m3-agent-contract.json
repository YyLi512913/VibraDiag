{
  "contract_version": "m3-t01-design-contract-v1",
  "implementation_stage": "DTOs and pure policy checks only",
  "schemas": {
    "create_task": {
      "additionalProperties": false,
      "properties": {
        "measurement_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Revision Id"
        },
        "goal": {
          "enum": [
            "inspect_signal",
            "bearing_observations",
            "compare_measurements",
            "explain_method"
          ],
          "title": "Goal",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "comparison_declaration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Declaration Id"
        }
      },
      "required": [
        "goal",
        "description"
      ],
      "title": "CreateAgentTask",
      "type": "object"
    },
    "resume_task": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "question_id": {
          "format": "uuid",
          "title": "Question Id",
          "type": "string"
        },
        "answer": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "expected_version",
        "question_id",
        "answer"
      ],
      "title": "ResumeAgentTask",
      "type": "object"
    },
    "model_decision": {
      "$defs": {
        "AskInformation": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "ask_information",
              "title": "Action",
              "type": "string"
            },
            "question_id": {
              "format": "uuid",
              "title": "Question Id",
              "type": "string"
            },
            "rationale": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            }
          },
          "required": [
            "action",
            "question_id",
            "rationale"
          ],
          "title": "AskInformation",
          "type": "object"
        },
        "ChooseAction": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "choose_action",
              "title": "Action",
              "type": "string"
            },
            "candidate_id": {
              "format": "uuid",
              "title": "Candidate Id",
              "type": "string"
            },
            "rationale": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            }
          },
          "required": [
            "action",
            "candidate_id",
            "rationale"
          ],
          "title": "ChooseAction",
          "type": "object"
        },
        "FinishDecision": {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "finish",
              "title": "Action",
              "type": "string"
            },
            "outcome": {
              "enum": [
                "analysis_only",
                "insufficient_evidence"
              ],
              "title": "Outcome",
              "type": "string"
            },
            "rationale": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            }
          },
          "required": [
            "action",
            "outcome",
            "rationale"
          ],
          "title": "FinishDecision",
          "type": "object"
        }
      },
      "discriminator": {
        "mapping": {
          "ask_information": "#/$defs/AskInformation",
          "choose_action": "#/$defs/ChooseAction",
          "finish": "#/$defs/FinishDecision"
        },
        "propertyName": "action"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChooseAction"
        },
        {
          "$ref": "#/$defs/AskInformation"
        },
        {
          "$ref": "#/$defs/FinishDecision"
        }
      ]
    },
    "unpublished_draft": {
      "$defs": {
        "Citation": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "basic_analysis",
                "tool_run",
                "fact",
                "evidence",
                "knowledge_chunk"
              ],
              "title": "Kind",
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "title": "Citation",
          "type": "object"
        },
        "DraftObservation": {
          "additionalProperties": false,
          "properties": {
            "claim_kind": {
              "enum": [
                "numeric_fact",
                "exploratory_observation",
                "method_explanation"
              ],
              "title": "Claim Kind",
              "type": "string"
            },
            "text": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Text",
              "type": "string"
            },
            "citations": {
              "items": {
                "$ref": "#/$defs/Citation"
              },
              "maxItems": 10,
              "minItems": 1,
              "title": "Citations",
              "type": "array"
            }
          },
          "required": [
            "claim_kind",
            "text",
            "citations"
          ],
          "title": "DraftObservation",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "m3-exploratory-draft-v1",
          "default": "m3-exploratory-draft-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "analysis_only",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/DraftObservation"
          },
          "maxItems": 20,
          "title": "Observations",
          "type": "array"
        },
        "missing_requirements": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Requirements",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "next_steps": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Next Steps",
          "type": "array"
        },
        "publication_state": {
          "const": "unpublished_draft",
          "default": "unpublished_draft",
          "title": "Publication State",
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary",
        "observations",
        "missing_requirements",
        "limitations",
        "next_steps"
      ],
      "title": "ExploratoryDraft",
      "type": "object"
    },
    "internal_budget": {
      "$defs": {
        "Reservation": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Key",
              "type": "string"
            },
            "kind": {
              "enum": [
                "model",
                "tool"
              ],
              "title": "Kind",
              "type": "string"
            },
            "retries_used": {
              "default": 0,
              "maximum": 1,
              "minimum": 0,
              "title": "Retries Used",
              "type": "integer"
            }
          },
          "required": [
            "key",
            "kind"
          ],
          "title": "Reservation",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "agent-budget-v1",
          "default": "agent-budget-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "active_ms": {
          "default": 0,
          "maximum": 120000,
          "minimum": 0,
          "title": "Active Ms",
          "type": "integer"
        },
        "reservations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reservation"
          },
          "title": "Reservations",
          "type": "array"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    },
    "task_status": {
      "enum": [
        "queued",
        "running",
        "waiting_information",
        "completed",
        "completed_degraded",
        "refused",
        "failed",
        "cancelled",
        "interrupted",
        "superseded",
        "budget_exhausted",
        "timed_out"
      ],
      "type": "string"
    }
  },
  "limits": {
    "model_logical_rounds": 8,
    "logical_tool_calls": 20,
    "automatic_retries_per_logical_call": 1,
    "active_execution_ms": 120000
  },
  "budget_semantics": {
    "reserve_before_dispatch": true,
    "unknown_outcome_does_not_refund": true,
    "resume_preserves_reservations_and_time": true,
    "manual_wait_is_not_active_execution": true,
    "format_repair_is_new_model_round": true,
    "network_retry_consumes_attempt_and_elapsed_time": true
  },
  "server_owned": [
    "organization and actor scope",
    "input and confirmation resolution",
    "candidate IDs and payloads",
    "question IDs",
    "logical call keys",
    "evidence resolution/validity",
    "budgets and model configuration"
  ],
  "not_implemented_here": [
    "formal task API",
    "LangGraph runtime with durable checkpoint",
    "worker queue/lease/CAS ledger",
    "published knowledge search",
    "formal model/draft semantic evaluation"
  ],
  "formal_diagnostic_release": false,
  "factory_trial_approved": false
}
